/*
 * mcp_authz.spthy -- REFERENCE RECONSTRUCTION (C1) for cross-checking.
 *
 * This file was reconstructed from the manuscript's Section 4/5 description
 * and the lemma sketches in Listing 2. It is intended for verdict-level
 * comparison against the author's original theory file; the original file
 * in the artefact repository remains authoritative. Rule and action names
 * follow the manuscript (Issue, ASran, ClientDone, Accept).
 *
 * Model: MCP authorisation flow -- OAuth 2.1 authorisation-code grant with
 * PKCE (RFC 7636), Resource Indicators (RFC 8707, `resource` parameter =
 * canonical MCP server URI), audience-restricted access tokens, and
 * RFC 9728 protected-resource metadata discovery (abstracted; discovery
 * integrity is not a target of the lemmas below). The adversary is
 * Dolev-Yao, extended with an injection channel: attacker-influenceable
 * tool metadata may trigger client invocations, but the adversary cannot
 * forge authorisation-server signatures.
 *
 * Channel abstractions (stated for reviewer transparency):
 *  - Front-channel redirect (authorisation code): public network (Out/In).
 *  - Token endpoint: any principal may connect (In), the response is
 *    returned on the requesting client's TLS session (private fact
 *    TokenResp bound to the client identity registered with the code).
 *  - Tool invocation: TLS to the addressed server (private fact InvokeCh);
 *    additionally, any TLS peer -- including the adversary holding a leaked
 *    token -- may present a token to an honest server (In path).
 *
 * Run (full model, expected: 4/4 lemmas PROVEN):
 *   time tamarin-prover --prove mcp_authz.spthy 2>&1 | tee tamarin_mcp_authz.log
 *
 * Run (-aud variant, audience check omitted; expected: lemma
 * confused_deputy_resistance FALSIFIED with an attack trace in which a
 * malicious S_A leaks the client's audience-S_A token and the adversary
 * replays it at honest S_B):
 *   time tamarin-prover --prove -D=NOAUD mcp_authz.spthy 2>&1 | tee tamarin_mcp_authz_noaud.log
 */

theory MCP_Authz
begin

builtins: hashing, signing

/* ---------------------------------------------------------------- */
/* Restrictions                                                     */
/* ---------------------------------------------------------------- */

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

restriction SingleASSetup:
  "All #i #j. OnlyOnce('as_setup') @ #i & OnlyOnce('as_setup') @ #j ==> #i = #j"

// A server URI registers exactly one role (honest xor malicious).
restriction ServerRoleUnique:
  "All s #i #j. RoleOnce(s) @ #i & RoleOnce(s) @ #j ==> #i = #j"

/* ---------------------------------------------------------------- */
/* Setup                                                            */
/* ---------------------------------------------------------------- */

rule AS_Setup:
  [ Fr(~sk) ]
  --[ OnlyOnce('as_setup') ]->
  [ !ASKey(~sk), !ASPk(pk(~sk)), Out(pk(~sk)) ]

rule Server_Register_Honest:
  [ ]
  --[ HonestServer($S), RoleOnce($S) ]->
  [ !HServer($S) ]

rule Server_Register_Malicious:
  [ ]
  --[ MaliciousServer($S), RoleOnce($S) ]->
  [ !MServer($S) ]

/* ---------------------------------------------------------------- */
/* OAuth 2.1 + PKCE + RFC 8707                                      */
/* ---------------------------------------------------------------- */

// Steps 1-5: authorisation request; the client generates the PKCE code
// verifier and names the target resource (RFC 8707) by its canonical URI.
rule Client_AuthzReq:
  [ Fr(~cv) ]
  --[ ClientStart($C, $S) ]->
  [ ClientSt1($C, $S, ~cv), Out(<'authz', $C, $S, h(~cv)>) ]

// Step 6: the AS binds a fresh authorisation code to (client, resource,
// code challenge); the code returns via the front-channel redirect.
rule AS_Code:
  [ In(<'authz', C, res, cc>), Fr(~code) ]
  --[ ASCode(C, res) ]->
  [ ASBind(C, res, cc, ~code), Out(~code) ]

// Step 7 (client side): redeem the code with the code verifier at the
// token endpoint (TLS; request contents modelled as observable to keep
// the adversary maximally strong -- PKCE, not transport secrecy, is what
// protects redemption).
rule Client_Redeem:
  [ ClientSt1(C, S, cv), In(code) ]
  --[ ClientRedeem(C, S) ]->
  [ ClientSt2(C, S, code), Out(<'redeem', code, cv>) ]

// Step 7 (AS side): PKCE check, single-use code (linear ASBind), token
// minted with audience = registered resource URI, returned on the
// registered client's session.
rule AS_Token:
  let body = <'tok', C, res, ~nt>
      t    = <body, sign(body, sk)>
  in
  [ In(<'redeem', code, cv>), ASBind(C, res, cc, code), Fr(~nt), !ASKey(sk) ]
  --[ Eq(h(cv), cc),
      ASran(C, res, code),
      Issue(C, res, ~nt),
      IssueTok(C, res, ~nt, t) ]->
  [ TokenResp(C, res, code, t) ]

// Client completes the grant.
rule Client_Token:
  [ ClientSt2(C, S, code), TokenResp(C, S, code, t) ]
  --[ ClientDone(C, S, code) ]->
  [ !ClientTok(C, S, t) ]

/* ---------------------------------------------------------------- */
/* Step 8: invocation, injection channel, token handling            */
/* ---------------------------------------------------------------- */

// Ordinary invocation: the client presents, over TLS, the token it holds
// for exactly the server it addresses (per-server token store).
rule Client_Invoke:
  [ !ClientTok(C, S, t) ]
  --[ ClientInvoke(C, S) ]->
  [ InvokeCh(S, t) ]

// Injection channel: adversary-influenced tool metadata may trigger an
// invocation of a chosen server; the client still uses the token bound to
// that server (it cannot be steered into cross-audience token reuse, and
// -- crucially -- the adversary cannot fabricate the signed audience).
rule Client_Invoke_Injected:
  [ !ClientTok(C, S, t), In(<'inject', C, S>) ]
  --[ ClientInvoke(C, S), Injected(C, S) ]->
  [ InvokeCh(S, t) ]

// A malicious server leaks every token presented to it (this is the
// source of the -aud confused-deputy replay).
rule MServer_Leak:
  [ InvokeCh(S, t), !MServer(S) ]
  --[ Leak(S) ]->
  [ Out(t) ]

// Honest server: accept a token presented on the client's TLS session.
rule HServer_Accept_Direct:
  let body = <'tok', C, aud, nt> in
  [ InvokeCh(S, <body, sig>), !HServer(S), !ASPk(pkAS) ]
  --[ Eq(verify(sig, body, pkAS), true)
#ifdef NOAUD
#else
    , Eq(aud, S)
#endif
    , Accept(S, <body, sig>)
    , AcceptAud(S, aud)
  ]->
  [ ]

// Honest server: any TLS peer may open a session and present a token
// (this is how a leaked token is replayed by the adversary).
rule HServer_Accept_Net:
  let body = <'tok', C, aud, nt> in
  [ In(<body, sig>), !HServer(S), !ASPk(pkAS) ]
  --[ Eq(verify(sig, body, pkAS), true)
#ifdef NOAUD
#else
    , Eq(aud, S)
#endif
    , Accept(S, <body, sig>)
    , AcceptAud(S, aud)
  ]->
  [ ]

/* ---------------------------------------------------------------- */
/* Lemmas (P1-P4; Table 3, upper block)                             */
/* ---------------------------------------------------------------- */

// P1 -- Token secrecy: a token issued for an honest resource never
// becomes adversary knowledge. (Tokens issued for malicious resources are
// deliberately out of scope: the client legitimately hands them to their
// audience.)
lemma token_secrecy:
  "All C res nt t #i #h.
     IssueTok(C, res, nt, t) @ #i & HonestServer(res) @ #h
   ==> not (Ex #j. K(t) @ #j)"

// P2 -- Injective agreement on code redemption (manuscript Listing 2).
lemma injective_agreement:
  "All C res code #i.
     ClientDone(C, res, code) @ #i
   ==> (Ex #j. ASran(C, res, code) @ #j & #j < #i)
     & not (Ex C2 res2 #i2.
              ClientDone(C2, res2, code) @ #i2 & not (#i2 = #i))"

// P3 -- Audience binding: an honest server only accepts tokens whose
// audience equals its own canonical URI.
lemma audience_binding:
  "All S aud #i.
     AcceptAud(S, aud) @ #i ==> aud = S"

// P4 -- Confused-deputy resistance: every token accepted at an honest
// server S_b was actually issued (by the AS) for resource S_b; hence a
// malicious S_a cannot redeem the client's audience-S_a token at S_b.
// Expected: PROVEN (full model); FALSIFIED under -D=NOAUD with a trace
//   Client_Invoke -> MServer_Leak -> HServer_Accept_Net.
lemma confused_deputy_resistance:
  "All Sb C aud nt sig #i #h.
     HonestServer(Sb) @ #h
     & Accept(Sb, <<'tok', C, aud, nt>, sig>) @ #i
   ==> Ex #j. Issue(C, Sb, nt) @ #j"

end
